# ============================================================
# TRIPGRID ENVIRONMENT CONFIGURATION (MAILPIT - LOCAL DEV)
# ============================================================

# ------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USERNAME=tripgrid
DB_PASSWORD=tripgrid_secret

# ------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# 3. RabbitMQ Configuration
# ------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=tripgrid
RABBITMQ_PASSWORD=tripgrid_secret
RABBITMQ_EXCHANGE=tripgrid.events

# ------------------------------------------------------------
# 4. JWT Security Configuration
# ------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000          # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000       # 7 days

# ------------------------------------------------------------
# 5. Local Mailpit SMTP Configuration
# Web UI: http://localhost:8025
# ------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_FROM=no-reply@tripgrid.com

# ------------------------------------------------------------
# 6. Service Ports & Gateway
# ------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
EMAIL_SERVICE_PORT=8082
AUTH_SERVICE_URL=http://localhost:8081

# ------------------------------------------------------------
# 7. Data Seeding
# ------------------------------------------------------------
SEED_DATA_ENABLED=true
